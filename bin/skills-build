#!/usr/bin/env python3
"""Regenerate hub SKILL.md indexes and CATALOG.tsv from leaf frontmatter.

Layout this enforces (see skill/README.md for the rationale):

    skill/
      <hub>/
        SKILL.md      hub: frontmatter name+description, plus a generated index
        <leaf>.md     leaf: frontmatter title+when, body is the actual content
      CATALOG.tsv     generated, every leaf in one grep-able table

Only files named SKILL.md are discovered by opencode, so leaves stay out of the
system prompt until something reads them. Leaves must sit directly beside their
SKILL.md: opencode auto-allows skill dirs through the external-directory
boundary as `<dir>/*`, one level only, so a nested subdir can trigger a
permission prompt on every read.

Usage:
    skills-build            rewrite indexes and CATALOG.tsv
    skills-build --check    report drift, write nothing, exit 1 if stale
"""

from __future__ import annotations

import os
import sys
from pathlib import Path

ROOT = Path(os.environ.get("OPENCODE_SKILL_ROOT", Path.home() / ".config/opencode/skill"))
CATALOG = ROOT / "CATALOG.tsv"
BEGIN = "<!-- BEGIN GENERATED INDEX -->"
END = "<!-- END GENERATED INDEX -->"
DESC_MAX = 400

problems: list[str] = []
notes: list[str] = []


def problem(msg: str) -> None:
    problems.append(msg)


def parse_frontmatter(path: Path) -> tuple[dict[str, str], str]:
    """Minimal `key: value` frontmatter reader. No YAML dependency on purpose."""
    text = path.read_text(encoding="utf-8")
    if not text.startswith("---"):
        return {}, text
    end = text.find("\n---", 3)
    if end == -1:
        return {}, text
    block, body = text[3:end], text[end + 4 :]
    meta: dict[str, str] = {}
    for line in block.splitlines():
        line = line.strip()
        if not line or line.startswith("#") or ":" not in line:
            continue
        key, _, value = line.partition(":")
        value = value.strip()
        if len(value) >= 2 and value[0] == value[-1] and value[0] in "\"'":
            value = value[1:-1]
        meta[key.strip()] = value
    return meta, body.lstrip("\n")


def collect_leaves(hub_dir: Path) -> list[tuple[Path, dict[str, str]]]:
    leaves = []
    for leaf in sorted(hub_dir.iterdir()):
        if leaf.is_dir():
            problem(f"{leaf}: nested directory — flatten it, `<hub>/*` is the "
                    f"only path auto-allowed through external_directory")
            continue
        if leaf.name == "SKILL.md" or leaf.suffix != ".md":
            continue
        meta, _ = parse_frontmatter(leaf)
        if not meta.get("title"):
            problem(f"{leaf}: missing frontmatter `title`")
            continue
        if not meta.get("when"):
            problem(f"{leaf}: missing frontmatter `when` — the hub index is "
                    f"useless without it")
            continue
        leaves.append((leaf, meta))
    return leaves


def render_index(hub_dir: Path, leaves: list[tuple[Path, dict[str, str]]]) -> str:
    lines = [
        BEGIN,
        "",
        "## Topics in this skill",
        "",
        f"Each entry below is a file in `{hub_dir}`. Read the one whose *use "
        "when* matches the task — do not read them all. This list is complete "
        "and authoritative; ignore the sampled file list appended by the skill "
        "tool.",
        "",
    ]
    for leaf, meta in leaves:
        lines.append(f"- **{meta['title']}** — use when: {meta['when']}")
        lines.append(f"  read `{leaf}`")
    lines += ["", END]
    return "\n".join(lines)


def splice(text: str, index: str, path: Path) -> str:
    start, stop = text.find(BEGIN), text.find(END)
    if start == -1 or stop == -1:
        problem(f"{path}: no {BEGIN} / {END} markers to write the index into")
        return text
    return text[:start] + index + text[stop + len(END) :]


def main() -> int:
    check = "--check" in sys.argv[1:]
    if not ROOT.is_dir():
        print(f"skill root not found: {ROOT}", file=sys.stderr)
        return 2

    rows: list[str] = []
    stale: list[Path] = []
    seen_names: dict[str, Path] = {}

    for hub_dir in sorted(p for p in ROOT.iterdir() if p.is_dir()):
        skill_md = hub_dir / "SKILL.md"
        if not skill_md.is_file():
            problem(f"{hub_dir}: no SKILL.md — the hub is invisible to opencode")
            continue

        meta, _ = parse_frontmatter(skill_md)
        name, desc = meta.get("name", ""), meta.get("description", "")
        if not name:
            problem(f"{skill_md}: missing frontmatter `name`")
        elif name != hub_dir.name:
            problem(f"{skill_md}: name `{name}` != directory `{hub_dir.name}`")
        if not desc:
            problem(f"{skill_md}: missing `description` — opencode silently "
                    f"drops skills without one, it will never be offered")
        elif len(desc) > DESC_MAX:
            notes.append(f"{skill_md}: description is {len(desc)} chars; every "
                         f"one is spent in every system prompt")
        if name:
            if name in seen_names:
                problem(f"duplicate skill name `{name}`: {seen_names[name]} and {skill_md}")
            seen_names[name] = skill_md

        leaves = collect_leaves(hub_dir)
        if not leaves:
            problem(f"{hub_dir}: no leaves — an empty hub costs prompt tokens "
                    f"and returns nothing; add content or remove it")
            continue

        current = skill_md.read_text(encoding="utf-8")
        updated = splice(current, render_index(hub_dir, leaves), skill_md)
        if updated != current:
            stale.append(skill_md)
            if not check:
                skill_md.write_text(updated, encoding="utf-8")

        for leaf, lmeta in leaves:
            rows.append("\t".join([hub_dir.name, str(leaf), lmeta["title"], lmeta["when"]]))

    header = "hub\tpath\ttitle\twhen"
    catalog = "\n".join([header, *sorted(rows)]) + "\n"
    existing = CATALOG.read_text(encoding="utf-8") if CATALOG.exists() else ""
    if existing != catalog:
        if check:
            stale.append(CATALOG)
        else:
            CATALOG.write_text(catalog, encoding="utf-8")

    for note in notes:
        print(f"note: {note}")
    for p in problems:
        print(f"error: {p}", file=sys.stderr)

    if check and stale:
        for p in stale:
            print(f"stale: {p}", file=sys.stderr)
        print(f"{len(stale)} file(s) out of date; run skills-build", file=sys.stderr)
        return 1

    verb = "would update" if check else "updated"
    print(f"{len(seen_names)} hubs, {len(rows)} leaves, {verb} {len(stale)} file(s)")
    return 1 if problems else 0


if __name__ == "__main__":
    raise SystemExit(main())
