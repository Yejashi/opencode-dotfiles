#!/usr/bin/env python3
"""Regenerate the opencode-ecosystem leaves from the awesome-opencode registry.

awesome-opencode is a link registry, not a skill corpus: ~223 YAML stubs, each
naming a community plugin/agent/project/theme and its repo, plus a generated
dist/registry.json. This turns that into one leaf per category so an agent can
answer "does something already exist for X?" without guessing at repo names.

    skills-import-awesome            refresh the clone and rewrite the leaves
    skills-import-awesome --offline  rewrite from the existing clone only

Run skills-build afterwards to refresh the hub index.
"""

from __future__ import annotations

import json
import subprocess
import sys
from collections import defaultdict
from pathlib import Path

REPO = "https://github.com/awesome-opencode/awesome-opencode.git"
CACHE = Path.home() / ".cache/opencode-awesome"
OUT = Path.home() / ".config/opencode/skill/opencode-ecosystem"

# type -> (leaf filename, title, `when` trigger line)
CATEGORIES = {
    "plugins": ("plugins.md", "Community OpenCode plugins",
                "looking for an existing plugin before writing one — auth, memory, context, "
                "notifications, sessions, git, or any hook-based extension"),
    "projects": ("projects.md", "Projects and tools built on OpenCode",
                 "looking for an existing GUI, wrapper, proxy, bridge, or integration around "
                 "OpenCode instead of building one"),
    "agents": ("agents.md", "Community agent and subagent packs",
               "looking for ready-made agent definitions, subagent collections, or "
               "orchestration setups to borrow from"),
    "themes": ("themes.md", "Community TUI themes",
               "changing the OpenCode TUI colour scheme"),
    "resources": ("resources.md", "Guides, starters, and reference material",
                  "looking for tutorials, starter configs, or written guides about OpenCode"),
}

HEADER = """---
title: {title}
when: {when}
---

# {title}

{count} entries from the awesome-opencode registry, regenerated by
`~/.config/opencode/bin/skills-import-awesome`.

These are **third-party and unvetted** — the registry lists them, it does not
endorse or audit them. Treat an entry as a lead to go read the repo, never as a
recommendation to install. Verify anything before running it.

"""


def refresh_clone(offline: bool) -> None:
    if offline:
        if not (CACHE / "dist/registry.json").is_file():
            sys.exit(f"--offline but no clone at {CACHE}")
        return
    if (CACHE / ".git").is_dir():
        subprocess.run(["git", "-C", str(CACHE), "pull", "--ff-only", "--quiet"], check=True)
    else:
        CACHE.parent.mkdir(parents=True, exist_ok=True)
        subprocess.run(["git", "clone", "--depth", "1", "--quiet", REPO, str(CACHE)], check=True)


def main() -> int:
    refresh_clone("--offline" in sys.argv[1:])
    registry = json.loads((CACHE / "dist/registry.json").read_text(encoding="utf-8"))

    by_type: dict[str, list[dict]] = defaultdict(list)
    for entry in registry:
        by_type[entry.get("type", "")].append(entry)

    OUT.mkdir(parents=True, exist_ok=True)
    unknown = sorted(set(by_type) - set(CATEGORIES))
    if unknown:
        print(f"note: registry has unmapped types, not written: {', '.join(unknown)}")

    total = 0
    for kind, (filename, title, when) in CATEGORIES.items():
        entries = sorted(by_type.get(kind, []), key=lambda e: e.get("displayName", "").lower())
        if not entries:
            print(f"note: no entries of type {kind}; leaving {filename} alone")
            continue
        lines = [HEADER.format(title=title, when=when, count=len(entries))]
        for e in entries:
            name = e.get("displayName") or e.get("productId", "?")
            desc = (e.get("description") or e.get("tagline") or "").strip()
            lines.append(f"- **{name}** — {desc}\n  {e.get('repoUrl', '')}")
        (OUT / filename).write_text("\n".join(lines) + "\n", encoding="utf-8")
        total += len(entries)
        print(f"{filename}: {len(entries)} entries")

    rev = subprocess.run(["git", "-C", str(CACHE), "rev-parse", "--short", "HEAD"],
                         capture_output=True, text=True).stdout.strip()
    print(f"{total} entries from awesome-opencode @ {rev}")
    print("now run: ~/.config/opencode/bin/skills-build")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
